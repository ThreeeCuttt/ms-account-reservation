<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="003-create-account" author="kolya">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="account"/>
            </not>
        </preConditions>

        <createTable tableName="account">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_account"/>
            </column>
            <column name="status_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="account_type" type="VARCHAR(50)"/>
            <column name="currency_code" type="VARCHAR(3)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="account"
                baseColumnNames="status_id"
                referencedTableName="account_status"
                referencedColumnNames="id"
                constraintName="fk_account_status_id"/>

        <addForeignKeyConstraint
                baseTableName="account"
                baseColumnNames="client_id"
                referencedTableName="client"
                referencedColumnNames="id"
                constraintName="fk_account_client_id"/>
    </changeSet>

</databaseChangeLog>