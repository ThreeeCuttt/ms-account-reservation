<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-insert-account-status-data" author="kolya">
        <insert tableName="account_status">
            <column name="name" value="NEW"/>
            <column name="description" value="Счёт создан в БД"/>
        </insert>
        <insert tableName="account_status">
            <column name="name" value="IN_CREATION"/>
            <column name="description" value="Запрос на создание счета был отправлен в смежную систему"/>
        </insert>
        <insert tableName="account_status">
            <column name="name" value="CREATED"/>
            <column name="description" value="Счёт создан в смежной системе"/>
        </insert>
        <insert tableName="account_status">
            <column name="name" value="CANCELLED"/>
            <column name="description" value="Счёт аннулирован"/>
        </insert>
        <insert tableName="account_status">
            <column name="name" value="CLOSED"/>
            <column name="description" value="Счёт закрыт"/>
        </insert>
    </changeSet>

</databaseChangeLog>